# GitHub personal access token — required for API access beyond anonymous rate limits
# Create one at: https://github.com/settings/tokens (needs repo scope for private repos)
GITHUB_TOKEN=your_github_personal_access_token_here

# PostgreSQL connection string — uses local postgres with admin credentials
# Default postgres superuser: postgres/postgres — adjust password as needed
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inspector_pika

# Express server port
PORT=3000
